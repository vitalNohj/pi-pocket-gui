{
    "name": "pi-pocket-gui",
    "productName": "Pi Pocket",
    "version": "0.1.5",
    "description": "Desktop app for a Pi Pocket server: tray, badge, native notifications, and offline dictation.",
    "license": "MIT",
    "author": "vitalNohj",
    "homepage": "https://github.com/vitalNohj/pi-pocket-gui",
    "repository": {
        "type": "git",
        "url": "https://github.com/vitalNohj/pi-pocket-gui.git"
    },
    "main": "dist/main/index.js",
    "private": true,
    "scripts": {
        "build": "node scripts/clean.mjs && tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
        "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
        "start": "npm run build && electron .",
        "test": "npm run build && node --test dist/test/*.test.js",
        "dist:linux": "npm run build && electron-builder --publish never --linux",
        "dist:mac": "npm run build && electron-builder --publish never --mac",
        "dist:win": "npm run build && electron-builder --publish never --win"
    },
    "build": {
        "appId": "io.github.vitalnohj.pipocketgui",
        "productName": "Pi Pocket",
        "artifactName": "pi-pocket-gui-${version}-${os}-${arch}.${ext}",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "!dist/test/**",
            "assets/**/*",
            "package.json"
        ],
        "publish": [
            {
                "provider": "github",
                "owner": "vitalNohj",
                "repo": "pi-pocket-gui"
            }
        ],
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Development",
            "icon": "assets/icon-512.png",
            "maintainer": "vitalNohj <vitalNohj@users.noreply.github.com>",
            "synopsis": "Desktop app for Pi Pocket",
            "executableName": "pi-pocket-gui"
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ],
            "category": "public.app-category.developer-tools",
            "icon": "assets/icon-512.png",
            "identity": "-",
            "hardenedRuntime": false,
            "extendInfo": {
                "NSMicrophoneUsageDescription": "Pi Pocket uses the microphone for dictation in the message box."
            }
        },
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "assets/icon-512.png",
            "executableName": "pi-pocket-gui"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false
        },
        "dmg": {
            "title": "Pi Pocket ${version}"
        }
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "electron": "45.1.0",
        "electron-builder": "26.18.1",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "electron-updater": "6.8.11"
    }
}
