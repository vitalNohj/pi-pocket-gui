{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": [],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true,
        "rootDir": "src",
        "outDir": "dist",
        "sourceMap": true
    },
    "include": ["src/renderer/**/*.ts", "src/shared/**/*.d.ts"]
}
